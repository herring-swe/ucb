---
BasedOnStyle: Chromium
IndentWidth: 4
UseTab: Never
ColumnLimit: 100

AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowAllArgumentsOnNextLine: false
IndentCaseLabels: false
SpacesBeforeTrailingComments: 1
# AlignAfterOpenBracket: true
# AlwaysBreakAfterReturnType: None
# BreakAfterOpenBracketFunction: true
# BreakBeforeCloseBracketFunction: true
# BreakAfterReturnType: Automatic
# PenaltyReturnTypeOnItsOwnLine: 10000000

BinPackArguments: false
BinPackParameters: false
# BinPackParametersStyle: OnePerLine

# Allman with few exceptions (namespace, extern block)
BreakBeforeBraces: Custom
BraceWrapping:
    AfterCaseLabel: true
    AfterClass: true
    AfterControlStatement: Always
    AfterEnum: true
    AfterFunction: true
    AfterNamespace: false
    AfterObjCDeclaration: true
    AfterStruct: true
    AfterUnion: true
    AfterExternBlock: false
    BeforeCatch: true
    BeforeElse: true
    BeforeLambdaBody: false
    BeforeWhile: false
    IndentBraces: false
    SplitEmptyFunction: true
    SplitEmptyRecord: true
    SplitEmptyNamespace: true

IncludeBlocks: Regroup
SortIncludes:
  IgnoreCase: true

IncludeCategories:
  # UCB
  - Regex:           '^[<"]ucb/'
    Priority:        2
    SortPriority:    2
    CaseSensitive:   true
  # Thirdparty inclusion
  - Regex:           '^((<|")(doctest))'
    Priority:        3
  # Standard library
  - Regex:           '<[[:alnum:]./]+.h>'
    Priority:        4
  # C++ standard library
  - Regex:           '<[[:alnum:]./]+>'
    Priority:        5
  # Anything else (must be last)
  - Regex:           '.*'
    Priority:        1
    SortPriority:    0
