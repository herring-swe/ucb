/**
 * This file is part of the UCB project
 * SPDX-FileCopyrightText: © 2026 Åke Svedin <ake@svedin.org>
 * SPDX-License-Identifier: MIT
 *
 * @file version.h
 * @brief Version and build capability defines.
 *
 * This header is generated by CMake from @c cmake/headers/version.h.cmake.in and is the
 * authoritative compile-time capability query surface of the library.
 *
 * All capability defines are always defined as @c 0 or @c 1, so they can be queried
 * directly without @c defined():
 * @code
 * #if UCB_OS_WINDOWS
 * // Windows specific code
 * #endif
 * @endcode
 *
 * The defines are split by their source of truth:
 * - Version numbers, optional components, backends and build kind describe the shipped
 *   library and are baked in by CMake.
 * - Platform and compiler describe the translation unit that includes this header and
 *   are derived here at include time, so a consumer built with a different compiler than
 *   the library still sees correct values.
 */

#ifndef UCB_VERSION_H
#define UCB_VERSION_H

/**
 * @name Version numbers
 * Baked by CMake from the project version.
 * @{
 */

/** @brief Major version number. */
#define UCB_VER_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor version number. */
#define UCB_VER_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch version number. */
#define UCB_VER_PATCH @PROJECT_VERSION_PATCH@

/**
 * @brief Version as a string literal, for example @c "1.2.3".
 */
#define UCB_VER_STRING "@PROJECT_VERSION@"

/**
 * @brief Numeric combined version for ABI checks and comparisons.
 *
 * Calculated as @c MAJOR*10000 + MINOR*100 + PATCH.
 */
#define UCB_VER ((UCB_VER_MAJOR * 10000) + (UCB_VER_MINOR * 100) + UCB_VER_PATCH)

/** @} */

/**
 * @name Build configuration
 * Baked by CMake for the shipped library.
 * @{
 */

/** @brief 1 if the library was built as a shared library, 0 if built as a static library. */
#cmakedefine01 UCB_BUILD_SHARED

/** @} */

/**
 * @name Optional components and backends
 *
 * Convention: an optional component @c <COMPONENT> exposes @c UCB_WITH_<COMPONENT> and a
 * backend @c <NAME> exposes @c UCB_BACKEND_<NAME>; both are defined as @c 0 or @c 1 and are
 * baked in by CMake. No optional component exists yet; the first planned is
 * @c UCB_WITH_ENCODING (Encoding API).
 * @{
 */

/** @} */

/**
 * @name Platform
 * Derived at include time for the consumer.
 * @{
 */

/** @brief 1 if the target platform is Windows, otherwise 0. */
#if defined(_WIN32)
#define UCB_OS_WINDOWS 1
#else
#define UCB_OS_WINDOWS 0
#endif

/** @brief 1 if the target platform is Linux, otherwise 0. */
#if defined(__linux__)
#define UCB_OS_LINUX 1
#else
#define UCB_OS_LINUX 0
#endif

/** @} */

/**
 * @name Compiler
 * Derived at include time for the consumer.
 * @{
 */

/** @brief 1 if compiled with Clang (including clang-cl), otherwise 0. */
#if defined(__clang__)
#define UCB_COMPILER_CLANG 1
#else
#define UCB_COMPILER_CLANG 0
#endif

/** @brief 1 if compiled with MSVC (excluding clang-cl), otherwise 0. */
#if defined(_MSC_VER) && !defined(__clang__)
#define UCB_COMPILER_MSVC 1
#else
#define UCB_COMPILER_MSVC 0
#endif

/** @brief 1 if compiled with GCC (excluding Clang), otherwise 0. */
#if defined(__GNUC__) && !defined(__clang__)
#define UCB_COMPILER_GCC 1
#else
#define UCB_COMPILER_GCC 0
#endif

/** @} */

#endif // UCB_VERSION_H